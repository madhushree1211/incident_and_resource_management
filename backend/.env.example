# Environment variables for Smart Campus backend

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartcampus?retryWrites=true&w=majority

# JWT settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Optional: Admin account for seed behavior
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SuperSecurePassword123!
